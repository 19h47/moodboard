<?xml version="1.0"?>
<ruleset name="Moodboard-Standards">
    <description>WordPress standards for the Moodboard plugin.</description>

    <file>.</file>

    <arg name="extensions" value="php" />

    <exclude-pattern>*/languages/*</exclude-pattern>
    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>

    <rule ref="WordPress" />

    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="moodboard" />
            </property>
        </properties>
    </rule>
    <!-- The capability of the curators: see Roles. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="curate_moodboard" />
            </property>
        </properties>
    </rule>
</ruleset>
