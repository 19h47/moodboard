{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": false,
		"target": "es2024",
		"module": "esnext",
		"moduleResolution": "bundler",
		"lib": [ "es2024", "esnext.array", "dom", "dom.iterable" ],
		"skipLibCheck": true,
		"types": [],
		"paths": {
			"moodboard-app/*": [ "./app/js/lib/*.js" ]
		}
	},
	"include": [ "app/js/**/*.js", "types/*.d.ts" ]
}
